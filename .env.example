# Copy to .env. Never commit, print or log a key.
PIXEL_API_BASE=https://api.start-hack.5u.ai
PIXEL_API_KEY=
# Stored once at the gateway with `uv run python -m tools.set_openai_key`; never sent anywhere else.
OPENAI_API_KEY=
# The model for every gateway call. Why this one: bench/MODELS.md. All models: GET /v1/gateway/models.
PIXEL_MODEL=gpt-4.1-mini
PIXEL_DB=data/pixel.sqlite3
# 1 = log outgoing mail and bookings as events, send nothing.
PIXEL_DRY_RUN=1
PIXEL_POLL_SECONDS=1.0
# Signs the mailbox's pushes to POST /hook: 16 or more random characters. Empty = every push is refused, the poll
# alone delivers. Subscribe with `uv run python -m tools.webhook <public url>/hook`.
PIXEL_WEBHOOK_SECRET=
# Seconds after the request: when we aim to send, and when the fallback sends whatever we have.
PIXEL_QUOTE_TARGET_S=100
PIXEL_QUOTE_HARD_S=315
