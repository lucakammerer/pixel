# Copy to .env. Never commit, print or log a key.
PIXEL_API_BASE=https://api.start-hack.5u.ai
PIXEL_API_KEY=
# The portal's browser page: rates are read there when the rate API answers 503. Empty: never.
PIXEL_PORTAL_PAGE=https://start-hack.5u.ai/portal/ui
# Stored once at the gateway with `uv run python -m tools.set_openai_key`; never sent anywhere else.
OPENAI_API_KEY=
# The model for every gateway call. Why this one: bench/MODELS.md. All models: GET /v1/gateway/models.
PIXEL_MODEL=gpt-4.1-mini
# Optional: a fast non-reasoning model for the quote's prose slots; empty uses PIXEL_MODEL.
PIXEL_MODEL_PROSE=
# Reads every request with attachments the rules read too; its figure wins where they disagree (bench/MODELS.md). Empty: off.
PIXEL_MODEL_CHECK=gpt-4.1
# The person who signs our customer mails.
PIXEL_SIGNER=Lena Berger
# Last check before a quote leaves (pixel/agents/rfq/check.py): on or off.
PIXEL_PRECHECK=on
PIXEL_REPAIR=on
# Known gaps before the quote (pixel/agents/rfq/gaps.py): on (read again, wait while it can change the quote), log or off.
PIXEL_GAPS=on
# The prose call reads the cargo too and a dissent has gpt-4.1 read the request: on, log (no escalation) or off.
PIXEL_SECOND_READ=log
PIXEL_DB=data/pixel.sqlite3
# 1 = log outgoing mail and bookings as events, send nothing.
PIXEL_DRY_RUN=1
PIXEL_POLL_SECONDS=1.0
# Signs the mailbox's pushes to POST /hook: 16 or more random characters. Empty = every push is refused, the poll
# alone delivers. Subscribe with `uv run python -m tools.webhook <public url>/hook`.
PIXEL_WEBHOOK_SECRET=
# Seconds after the request: when we aim to send, and when the fallback sends whatever we have.
PIXEL_QUOTE_TARGET_S=100
PIXEL_QUOTE_HARD_S=315
# Seconds a bid by mail (airline or trucker) may take from our ask, also past the target when we started late.
PIXEL_BID_WAIT_S=45
# Called with what needs repair (a missed, rejected or point-losing request), once per kind and deployed commit.
# Ours starts an agent's repair run. Empty: no call.
PIXEL_ALERT_URL=
# Voice calls to a late carrier or a customer with a missing fact (pixel/voice/README.md). Empty: no calls.
ELEVENLABS_API_KEY=
# Written by `uv run python -m tools.voice_agent`.
ELEVENLABS_AGENT_ID=
